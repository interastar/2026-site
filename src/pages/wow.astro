---
/* =========================================================================
   /wow : Exploración de rediseño "dark editorial" de la home de Interastar.
   Energía motion-led / tipografía display sobredimensionada inspirada en la
   línea premiada de estudio nk (nk.studio), DENTRO de la marca Interastar
   (navy/ink, acento cian, verde solo como realce). Página standalone de un
   solo tema (oscuro). No usa BaseLayout para no mezclar el tema claro de
   producción; reutiliza tokens de marca, contenido real y assets existentes.

   Reglas de forma: superficies rectas (radio 2px, editorial), botones píldora.
   Acento único: cian. Verde: realce puntual. Cero em-dash.
   ========================================================================= */
import '../styles/tokens.css';
import HeroBackground from '../components/HeroBackground.astro';
import Icon from '../components/Icon.astro';
import { path } from '../i18n/ui';
import { getPostCards } from '../lib/posts';

const lang = 'es' as const;
const posts = await getPostCards('es');
const [featured, ...rest] = posts;

const services = [
  { ic: 'database', title: 'Diseño e implementación', text: 'ERP y plataformas CX a la medida de tu industria, con una metodología probada de extremo a extremo.' },
  { ic: 'plug-zap', title: 'Integraciones a la medida', text: 'Conectamos ERP, CRM, CX y mensajería en un mismo flujo. Menos reproceso, cierre de mes más rápido.' },
  { ic: 'refresh-cw', title: 'Servicios administrados', text: 'Operamos y evolucionamos tus plataformas con soporte continuo para que tu equipo se enfoque en el negocio.' },
  { ic: 'graduation-cap', title: 'Consultoría y capacitación', text: 'Acompañamiento estratégico y formación de equipos para capturar el valor de cada plataforma.' },
];

const roles = [
  { ic: 'building-2', role: 'Dirección general', text: 'Escalabilidad y control para crecer sin sistemas fragmentados, con continuidad operativa garantizada.' },
  { ic: 'shield-check', role: 'TI y Sistemas', text: 'Seguridad, integraciones limpias y una implementación end-to-end que reduce el riesgo del proyecto.' },
  { ic: 'headset', role: 'Operaciones y CX', text: 'Omnicanalidad y visibilidad operativa con reportes accionables para decidir con datos, no con intuición.' },
];
const [leadRole, ...otherRoles] = roles;

const platforms = [
  { tag: 'Cloud ERP', name: 'Acumatica', text: 'ERP en la nube para finanzas, operaciones y cadena de suministro. Escalable y sin cobro por usuario.', href: path('acumatica', lang), shot: '/screens/acumatica-dashboard.png', tint: 'cyan' },
  { tag: 'Cloud CX', name: 'Genesys', text: 'Contact center omnicanal con enrutamiento inteligente y analítica en tiempo real.', href: path('genesys', lang), shot: '/screens/genesys-dashboard.png', tint: 'green' },
  { tag: 'IA conversacional', name: 'Numia', text: 'Asistentes de IA por voz y texto que automatizan atención y califican prospectos las 24 horas.', href: path('solutions', lang), logos: ['/partners/numia-white.png'] },
  { tag: 'Mensajería y CPaaS', name: 'Infobip y Vonage', text: 'APIs de comunicación para SMS, WhatsApp y voz integradas a tus sistemas centrales.', href: path('solutions', lang), logos: ['/partners/infobip-white.svg', '/partners/vonage.png'] },
];

const clients = ['petco', 'coppel', 'unilever', 'porsche', 'teleperformance', 'qualitas', 'city-express', 'pisa', 'caliente', 'vidanta', 'packsys', 'dlife', 'doto'];
const clientNames: Record<string, string> = { petco: 'Petco', coppel: 'Coppel', unilever: 'Unilever', porsche: 'Porsche', teleperformance: 'Teleperformance', qualitas: 'Qualitas', 'city-express': 'City Express', pisa: 'Pisa', caliente: 'Caliente', vidanta: 'Vidanta', packsys: 'Packsys', dlife: 'Dlife', doto: 'Doto' };

const navLinks = [
  { label: 'Soluciones', href: path('solutions', lang) },
  { label: 'Nosotros', href: path('about', lang) },
  { label: 'Insights', href: path('insights', lang) },
  { label: 'Contacto', href: path('contact', lang) },
];

const title = 'Interastar · Un solo sistema para tu ERP, CX e IA';
const description = 'Implementamos, integramos y operamos Acumatica, Genesys y las plataformas líderes para que tu operación funcione como una sola. Firma B2B e integrador de sistemas en LATAM.';
const canonical = 'https://www.interastar.com/wow/';
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/brand/star.svg" />
  <link rel="preload" href="/fonts/exo2-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/publicsans-latin.woff2" as="font" type="font/woff2" crossorigin />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
</head>
<body>
  <a href="#main" class="skip">Saltar al contenido</a>
  <div id="top" aria-hidden="true"></div>

  <!-- Nav: una sola línea, 72px, cristal oscuro -->
  <header class="nav" id="nav">
    <div class="wrap nav-inner">
      <a class="brand" href={path('home', lang)} aria-label="Interastar">
        <img src="/brand/logo-interastar-dark.svg" alt="Interastar" width="120" height="32" />
      </a>
      <nav class="nav-mid" aria-label="Principal">
        {navLinks.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
      <div class="nav-end">
        <a class="nav-ghost" href={path('home', lang)} aria-label="Ver el sitio en modo claro">Sitio actual</a>
        <a class="btn btn-primary" href={path('contact', lang)}>Agendar diagnóstico</a>
        <button id="navToggle" class="nav-toggle" aria-label="Menú" aria-expanded="false" aria-controls="navMobile"><Icon name="menu" size={24} /></button>
      </div>
    </div>
    <div class="nav-mobile" id="navMobile" hidden>
      {navLinks.map((l) => <a href={l.href}>{l.label}</a>)}
      <a class="btn btn-primary" href={path('contact', lang)}>Agendar diagnóstico</a>
    </div>
  </header>

  <main id="main">
    <!-- HERO -->
    <section class="hero">
      <HeroBackground />
      <div class="wrap hero-inner">
        <span class="eyebrow"><span class="star"></span>Socio en ERP, CX e IA</span>
        <h1 class="display">
          <span class="line-mask"><span class="line" style="--d:0">Tu <em>ERP</em>, tu <em class="g">CX</em> y tu <em>IA</em>,</span></span>
          <span class="line-mask"><span class="line" style="--d:1">operando como uno solo.</span></span>
        </h1>
        <p class="hero-sub">Implementamos, integramos y operamos Acumatica, Genesys y las plataformas líderes para que tu operación funcione como una sola.</p>
        <div class="hero-actions">
          <a class="btn btn-primary lg" href={path('contact', lang)}>Agendar diagnóstico<Icon name="arrow-right" size={18} /></a>
          <a class="btn btn-ghost lg" href={path('solutions', lang)}>Ver soluciones</a>
        </div>
      </div>
    </section>

    <!-- MARQUEE de clientes (único en la página) -->
    <section class="trust" aria-label="Empresas que confían en Interastar">
      <p class="trust-label">Empresas que confían en Interastar</p>
      <div class="marquee" data-marquee>
        <div class="marquee-track">
          {[...clients, ...clients].map((c, i) => (
            <img src={`/clients/${c}.png`} alt={i < clients.length ? clientNames[c] : ''} aria-hidden={i >= clients.length} height="24" loading="lazy" decoding="async" />
          ))}
        </div>
      </div>
    </section>

    <!-- CAPACIDADES: lista editorial -->
    <section class="section deep">
      <div class="wrap">
        <div class="head">
          <h2 class="display sm">Integración tecnológica de extremo a extremo.</h2>
          <p class="lede">No vendemos software propio. Implementamos, integramos y operamos las mejores plataformas del mercado en tu beneficio.</p>
        </div>
        <ul class="cap-list">
          {services.map((s) => (
            <li class="cap-row reveal">
              <span class="cap-ic"><Icon name={s.ic} /></span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- SEGMENTACIÓN por rol: mosaico asimétrico -->
    <section class="section deep">
      <div class="wrap">
        <div class="head">
          <h2 class="display sm">¿Desde dónde miras el cambio?</h2>
          <p class="lede">Cada decisión tecnológica se ve distinta según tu rol. Te llevamos directo a lo que te importa.</p>
        </div>
        <div class="seg-grid">
          <div class="seg-tile lead reveal">
            <span class="seg-ic"><Icon name={leadRole.ic} /></span>
            <div class="seg-body">
              <h3>{leadRole.role}</h3>
              <p>{leadRole.text}</p>
            </div>
          </div>
          {otherRoles.map((r) => (
            <div class="seg-tile reveal">
              <span class="seg-ic"><Icon name={r.ic} /></span>
              <div class="seg-body">
                <h3>{r.role}</h3>
                <p>{r.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- PLATAFORMAS: bento con capturas reales -->
    <section class="section lift">
      <div class="wrap">
        <div class="head">
          <span class="eyebrow"><span class="star"></span>Plataformas</span>
          <h2 class="display sm mt">Las plataformas líderes, implementadas por expertos.</h2>
        </div>
        <div class="bento">
          {platforms.map((p, i) => (
            <a class={`bento-cell reveal ${i === 0 ? 'wide tint-cyan' : ''} ${i === 1 ? 'tint-green' : ''} ${i === 2 ? '' : ''} ${i === 3 ? 'wide' : ''} ${p.shot ? 'has-shot' : ''}`} href={p.href}>
              {p.logos && <div class="cell-logos">{p.logos.map((l) => <img src={l} alt="" height="26" loading="lazy" decoding="async" />)}</div>}
              <span class="tag">{p.tag}</span>
              <h3 class="cell-name">{p.name}</h3>
              <p>{p.text}</p>
              <span class="link-arrow">Conocer más<Icon name="arrow-right" size={16} /></span>
              {p.shot && <img class="shot" src={p.shot} alt="" width="1200" height="694" loading="lazy" decoding="async" />}
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- STATS: banda de cifras -->
    <section class="stats">
      <div class="wrap stats-grid">
        <p class="stats-intro">Experiencia probada en ERP y CX para empresas de LATAM.</p>
        <div class="stat reveal">
          <div class="num">+15<b> años</b></div>
          <div class="stat-label">acompañando a empresas en su transformación.</div>
        </div>
        <div class="stat reveal">
          <div class="num">120<b>+</b></div>
          <div class="stat-label">proyectos de integración e implementación entregados.</div>
        </div>
      </div>
    </section>

    <!-- INSIGHTS: destacado + lista -->
    {featured && (
      <section class="section deep">
        <div class="wrap">
          <div class="head">
            <h2 class="display sm">Conocimiento para decidir mejor.</h2>
            <p class="lede">Tendencias, guías y casos sobre ERP, CX e IA aplicada al negocio.</p>
          </div>
          <div class="posts">
            <a class="post-feature reveal" href={featured.href}>
              <span class="post-meta"><span class="cat">{featured.category}</span><span>{featured.date}</span></span>
              <h3>{featured.title}</h3>
              <p>{featured.description}</p>
              <span class="link-arrow">Leer artículo<Icon name="arrow-right" size={16} /></span>
            </a>
            <div class="post-list">
              {rest.slice(0, 3).map((p) => (
                <a class="post-row reveal" href={p.href}>
                  <span class="post-meta"><span class="cat">{p.category}</span><span>{p.date}</span></span>
                  <h3>{p.title}</h3>
                </a>
              ))}
              <a class="link-arrow all" href={path('insights', lang)}>Ver todos los insights<Icon name="arrow-right" size={16} /></a>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- CTA: cierre manifiesto -->
    <section class="cta">
      <div class="wrap cta-inner">
        <h2 class="display">Una operación. <em class="g">Un socio.</em></h2>
        <p>Diagnóstico sin costo: revisamos tu stack actual y trazamos el camino hacia una operación unificada.</p>
        <a class="btn btn-primary lg" href={path('contact', lang)}>Agendar diagnóstico<Icon name="arrow-right" size={18} /></a>
      </div>
    </section>
  </main>

  <!-- FOOTER oscuro -->
  <footer class="foot">
    <div class="wrap foot-grid">
      <div class="foot-brand">
        <img src="/brand/logo-interastar-dark.svg" alt="Interastar" width="120" height="32" />
        <p>Firma de servicios tecnológicos B2B e integrador de sistemas. Unificamos ERP en la nube, plataformas CX e IA conversacional en una ventaja operativa.</p>
      </div>
      <div class="foot-col">
        <h4>Soluciones</h4>
        <a href={path('acumatica', lang)}>Acumatica ERP</a>
        <a href={path('genesys', lang)}>Genesys CX</a>
        <a href={path('solutions', lang)}>Integraciones a la medida</a>
        <a href={path('solutions', lang)}>Servicios administrados</a>
      </div>
      <div class="foot-col">
        <h4>Empresa</h4>
        <a href={path('about', lang)}>Nosotros</a>
        <a href={path('insights', lang)}>Insights</a>
        <a href={path('contact', lang)}>Contacto</a>
        <a href={path('privacy', lang)}>Aviso de privacidad</a>
      </div>
      <div class="foot-col">
        <h4>Contacto</h4>
        <a href="mailto:contacto@interastar.com">contacto@interastar.com</a>
        <a href="https://www.linkedin.com/company/interastar" rel="noopener" target="_blank">LinkedIn</a>
      </div>
    </div>
    <div class="wrap foot-base">
      <span>© {new Date().getFullYear()} Interastar. Todos los derechos reservados.</span>
      <span class="foot-note">Exploración de rediseño · rama ideas/wow</span>
    </div>
  </footer>

  <style>
    /* ---------- Tema oscuro local (lock) ---------- */
    :root {
      --w-bg: #04121c;
      --w-ink: #002233;
      --w-deep: #03101a;
      --w-lift: #061826;
      --w-darkest: #010a11;
      --w-surface: rgba(255,255,255,0.03);
      --w-surface-2: rgba(255,255,255,0.05);
      --w-line: rgba(255,255,255,0.10);
      --w-line-2: rgba(255,255,255,0.18);
      --w-fg: #eef5f9;
      --w-fg-2: rgba(226,238,245,0.68);
      --w-fg-3: rgba(226,238,245,0.42);
      --w-accent: #00a8ea;
      --w-accent-2: #40bef0;
      --w-green: #67db3c;
      --r: 2px;
      --easing: cubic-bezier(0.22, 0.61, 0.36, 1);
    }
    * , *::before, *::after { box-sizing: border-box; }
    html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
    body {
      margin: 0; background: var(--w-bg); color: var(--w-fg);
      font-family: var(--font-ui); font-size: 16px; line-height: 1.5;
      -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility;
      overflow-x: hidden;
    }
    img { max-width: 100%; height: auto; display: block; }
    a { color: inherit; text-decoration: none; }
    ::selection { background: var(--w-accent); color: #04121c; }
    :focus-visible { outline: 2px solid var(--w-accent); outline-offset: 3px; border-radius: var(--r); }
    .skip { position: absolute; left: -9999px; top: 8px; z-index: 100; background: var(--w-accent); color: #04121c; padding: 10px 14px; border-radius: var(--r); font-weight: 600; }
    .skip:focus { left: 8px; }

    .wrap { max-width: 1280px; margin-inline: auto; padding-inline: clamp(20px, 5vw, 56px); }

    /* ---------- Tipografía display ---------- */
    .display {
      font-family: var(--font-display);
      font-weight: 900; letter-spacing: -0.03em; line-height: 0.98;
      font-size: clamp(44px, 8.2vw, 116px); margin: 0; color: var(--w-fg);
      text-wrap: balance;
    }
    .display.sm { font-size: clamp(30px, 4.6vw, 58px); line-height: 1.02; letter-spacing: -0.025em; }
    .display em { font-style: normal; color: var(--w-accent); }
    .display em.g { color: var(--w-green); }

    .eyebrow {
      display: inline-flex; align-items: center; gap: 9px;
      font: 700 12px/1 var(--font-ui); letter-spacing: 0.16em; text-transform: uppercase;
      color: var(--w-accent-2);
    }
    .eyebrow .star { width: 13px; height: 13px; background: url("/brand/star.svg") center/contain no-repeat; }
    .lede { font: 400 clamp(16px, 1.8vw, 19px)/1.6 var(--font-ui); color: var(--w-fg-2); margin: 0; max-width: 60ch; }

    /* ---------- Botones (píldora) ---------- */
    .btn {
      font: 600 15px/1 var(--font-ui); padding: 14px 22px; border-radius: 999px;
      border: 1px solid transparent; display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      white-space: nowrap; cursor: pointer; transition: transform 160ms var(--easing), background-color 160ms var(--easing), border-color 160ms var(--easing), color 160ms var(--easing);
    }
    .btn.lg { padding: 17px 28px; font-size: 16px; }
    .btn svg { flex-shrink: 0; transition: transform 200ms var(--easing); }
    .btn-primary { background: var(--w-accent); color: #04121c; }
    .btn-primary:hover { background: var(--w-accent-2); transform: translateY(-2px); }
    .btn-primary:hover svg { transform: translateX(3px); }
    .btn-primary:active { transform: translateY(0); }
    .btn-ghost { background: transparent; color: var(--w-fg); border-color: var(--w-line-2); }
    .btn-ghost:hover { background: var(--w-surface-2); border-color: var(--w-fg); }

    .link-arrow { display: inline-flex; align-items: center; gap: 7px; font: 600 14px var(--font-ui); color: var(--w-accent-2); }
    .link-arrow svg { transition: transform 200ms var(--easing); }
    .link-arrow:hover svg { transform: translateX(3px); }

    /* ---------- Nav ---------- */
    .nav {
      position: sticky; top: 0; z-index: 50;
      background: rgba(4, 18, 28, 0.72); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
      border-bottom: 1px solid transparent; transition: border-color 240ms var(--easing), background-color 240ms var(--easing);
    }
    .nav[data-scrolled] { border-bottom-color: var(--w-line); background: rgba(3, 14, 22, 0.86); }
    .nav-inner { display: flex; align-items: center; gap: 28px; height: 72px; }
    .brand img { height: 26px; width: auto; }
    .nav-mid { display: flex; gap: 30px; margin-inline: auto; }
    .nav-mid a { font: 500 15px var(--font-ui); color: var(--w-fg-2); position: relative; padding: 4px 0; }
    .nav-mid a::after { content: ""; position: absolute; left: 0; bottom: 0; height: 1px; width: 0; background: var(--w-accent); transition: width 220ms var(--easing); }
    .nav-mid a:hover { color: var(--w-fg); }
    .nav-mid a:hover::after { width: 100%; }
    .nav-end { display: flex; align-items: center; gap: 14px; }
    .nav-ghost { font: 500 14px var(--font-ui); color: var(--w-fg-3); }
    .nav-ghost:hover { color: var(--w-fg); }
    .nav-toggle { display: none; background: transparent; border: 0; color: var(--w-fg); cursor: pointer; padding: 6px; }
    .nav-mobile { display: none; flex-direction: column; gap: 4px; padding: 10px clamp(20px, 5vw, 56px) 20px; border-bottom: 1px solid var(--w-line); background: rgba(3, 14, 22, 0.96); }
    .nav-mobile a { padding: 12px 0; font: 500 16px var(--font-ui); color: var(--w-fg); border-bottom: 1px solid var(--w-line); }
    .nav-mobile a.btn { border: 1px solid transparent; margin-top: 10px; justify-content: center; }
    @media (max-width: 900px) {
      .nav-mid, .nav-ghost { display: none; }
      .nav-toggle { display: inline-flex; }
      .nav-mobile[data-open] { display: flex; }
    }

    /* ---------- Hero ---------- */
    .hero { position: relative; overflow: hidden; background: var(--w-ink); min-height: calc(100svh - 72px); display: flex; align-items: center; }
    .hero-inner { position: relative; z-index: 2; padding: clamp(40px, 7vh, 96px) 0 clamp(48px, 8vh, 96px); max-width: 1160px; }
    .hero .eyebrow { color: var(--w-accent-2); }
    .hero h1 { margin: 20px 0 0; font-size: clamp(36px, 5.2vw, 78px); line-height: 0.96; }
    .line-mask { display: block; overflow: hidden; padding-bottom: 0.06em; }
    .line { display: block; transform: translateY(102%); animation: riseIn 0.9s var(--easing) forwards; animation-delay: calc(var(--d) * 0.12s + 0.08s); }
    @keyframes riseIn { to { transform: translateY(0); } }
    .hero-sub { margin: clamp(22px, 3vh, 34px) 0 0; font: 400 clamp(17px, 2vw, 21px)/1.55 var(--font-ui); color: var(--w-fg-2); max-width: 540px; opacity: 0; animation: fadeUp 0.8s var(--easing) 0.4s forwards; }
    .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; margin-top: clamp(26px, 4vh, 40px); opacity: 0; animation: fadeUp 0.8s var(--easing) 0.54s forwards; }
    @keyframes fadeUp { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }

    /* ---------- Marquee de clientes ---------- */
    .trust { background: var(--w-ink); padding: 30px 0 42px; border-top: 1px solid var(--w-line); }
    .trust-label { max-width: 1280px; margin: 0 auto 22px; padding-inline: clamp(20px, 5vw, 56px); font: 500 13px var(--font-ui); color: var(--w-fg-3); }
    .marquee { position: relative; -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
    .marquee-track { display: flex; align-items: center; gap: 56px; width: max-content; animation: scrollx 44s linear infinite; }
    .marquee:hover .marquee-track { animation-play-state: paused; }
    .marquee-track img { height: 24px; width: auto; max-width: 140px; object-fit: contain; opacity: 0.6; transition: opacity 200ms var(--easing); filter: saturate(0); }
    .marquee-track img:hover { opacity: 1; filter: none; }
    @keyframes scrollx { to { transform: translateX(-50%); } }

    /* ---------- Secciones ---------- */
    .section { padding-block: clamp(72px, 11vw, 150px); }
    .section.deep { background: var(--w-deep); }
    .section.lift { background: var(--w-lift); }
    .head { max-width: 860px; margin-bottom: clamp(44px, 6vw, 72px); }
    .head .lede { margin-top: 18px; }
    .mt { margin-top: 18px; }

    /* Lista editorial de capacidades */
    .cap-list { list-style: none; margin: 0; padding: 0; }
    .cap-row {
      display: grid; grid-template-columns: 56px minmax(220px, 1fr) 1.3fr; gap: 28px; align-items: start;
      padding: clamp(26px, 3.4vw, 40px) 0; border-top: 1px solid var(--w-line);
    }
    .cap-row:last-child { border-bottom: 1px solid var(--w-line); }
    .cap-ic { width: 52px; height: 52px; border: 1px solid var(--w-line-2); border-radius: var(--r); display: grid; place-items: center; color: var(--w-accent); }
    .cap-ic svg { width: 26px; height: 26px; }
    .cap-row h3 { font: 700 clamp(22px, 2.6vw, 30px)/1.1 var(--font-display); letter-spacing: -0.02em; margin: 0; color: var(--w-fg); }
    .cap-row p { font: 400 16px/1.6 var(--font-ui); color: var(--w-fg-2); margin: 6px 0 0; max-width: 48ch; }
    .cap-row:hover .cap-ic { border-color: var(--w-accent); color: var(--w-accent-2); }
    @media (max-width: 820px) { .cap-row { grid-template-columns: 44px 1fr; } .cap-row p { grid-column: 1 / -1; } .cap-ic { width: 44px; height: 44px; } }

    /* Mosaico de roles */
    .seg-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: 16px; }
    .seg-tile { border: 1px solid var(--w-line); background: var(--w-surface); padding: clamp(26px, 3vw, 38px); border-radius: var(--r); display: flex; flex-direction: column; gap: 22px; transition: border-color 220ms var(--easing), background-color 220ms var(--easing), transform 220ms var(--easing); }
    .seg-tile:hover { border-color: var(--w-line-2); background: var(--w-surface-2); transform: translateY(-3px); }
    .seg-tile.lead { grid-row: span 2; justify-content: space-between; background: linear-gradient(160deg, rgba(0,168,234,0.14), rgba(255,255,255,0.02)); border-color: rgba(0,168,234,0.28); }
    .seg-ic { width: 48px; height: 48px; border-radius: var(--r); display: grid; place-items: center; background: var(--w-surface-2); color: var(--w-accent); }
    .seg-tile.lead .seg-ic { background: rgba(0,168,234,0.18); }
    .seg-ic svg { width: 24px; height: 24px; }
    .seg-tile h3 { font: 700 clamp(20px, 2.2vw, 26px) var(--font-display); letter-spacing: -0.02em; margin: 0 0 10px; color: var(--w-fg); }
    .seg-tile p { font: 400 15px/1.6 var(--font-ui); color: var(--w-fg-2); margin: 0; max-width: 42ch; }
    @media (max-width: 820px) { .seg-grid { grid-template-columns: 1fr; } .seg-tile.lead { grid-row: auto; } }

    /* Bento de plataformas */
    .bento { display: grid; grid-template-columns: repeat(12, 1fr); gap: 16px; }
    .bento-cell { position: relative; overflow: hidden; grid-column: span 6; border: 1px solid var(--w-line); background: var(--w-surface); border-radius: var(--r); padding: clamp(26px, 3vw, 38px); min-height: 300px; display: flex; flex-direction: column; gap: 10px; transition: border-color 220ms var(--easing), transform 220ms var(--easing), background-color 220ms var(--easing); }
    .bento-cell.wide { grid-column: span 7; }
    .bento-cell.wide + .bento-cell:not(.wide) { grid-column: span 5; }
    .bento-cell:nth-child(3) { grid-column: span 5; }
    .bento-cell:nth-child(4) { grid-column: span 7; }
    .bento-cell:hover { transform: translateY(-4px); border-color: var(--w-line-2); }
    .bento-cell.tint-cyan { background: linear-gradient(155deg, rgba(0,168,234,0.16), rgba(255,255,255,0.02)); border-color: rgba(0,168,234,0.26); }
    .bento-cell.tint-green { background: linear-gradient(155deg, rgba(103,219,60,0.15), rgba(255,255,255,0.02)); border-color: rgba(103,219,60,0.24); }
    .bento-cell .tag { font: 600 13px var(--font-ui); color: var(--w-fg-3); }
    .bento-cell .cell-name { font: 900 clamp(26px, 3vw, 36px)/1 var(--font-display); letter-spacing: -0.025em; margin: 0; color: var(--w-fg); }
    .bento-cell p { font: 400 15px/1.6 var(--font-ui); color: var(--w-fg-2); margin: 0; max-width: 40ch; }
    .bento-cell .link-arrow { margin-top: auto; padding-top: 14px; }
    .cell-logos { display: flex; gap: 20px; align-items: center; margin-bottom: 6px; }
    .cell-logos img { height: 26px; width: auto; max-width: 130px; object-fit: contain; }
    .bento-cell .shot { position: absolute; right: -6%; bottom: -12%; width: 56%; border-radius: var(--r); box-shadow: 0 24px 60px rgba(0,0,0,0.5); border: 1px solid var(--w-line); pointer-events: none; }
    .bento-cell.has-shot .tag, .bento-cell.has-shot .cell-name, .bento-cell.has-shot p { max-width: 50%; }
    @media (max-width: 860px) {
      .bento-cell, .bento-cell.wide, .bento-cell:nth-child(3), .bento-cell:nth-child(4) { grid-column: span 12; }
      .bento-cell.has-shot { min-height: 360px; }
      .bento-cell.has-shot .tag, .bento-cell.has-shot .cell-name, .bento-cell.has-shot p { max-width: 58%; }
    }

    /* Banda de stats */
    .stats { background: var(--w-ink); border-block: 1px solid var(--w-line); padding-block: clamp(56px, 7vw, 92px); }
    .stats-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 40px clamp(40px, 6vw, 88px); align-items: start; }
    .stats-intro { font: 600 clamp(20px, 2.4vw, 28px)/1.3 var(--font-display); letter-spacing: -0.02em; color: var(--w-fg); margin: 0; max-width: 22ch; }
    .num { font: 900 clamp(48px, 6vw, 78px)/0.95 var(--font-display); letter-spacing: -0.03em; color: var(--w-fg); white-space: nowrap; }
    .num b { color: var(--w-green); font-weight: 900; font-size: 0.56em; letter-spacing: -0.02em; }
    .stat-label { font: 400 14px/1.5 var(--font-ui); color: var(--w-fg-2); margin-top: 12px; max-width: 230px; }
    @media (max-width: 780px) { .stats-grid { grid-template-columns: 1fr 1fr; } .stats-intro { grid-column: 1 / -1; } }

    /* Insights */
    .posts { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(28px, 4vw, 56px); align-items: start; }
    .post-feature { display: flex; flex-direction: column; gap: 14px; padding: clamp(28px, 3vw, 40px); min-height: 320px; justify-content: flex-end; border: 1px solid rgba(0,168,234,0.24); background: linear-gradient(160deg, rgba(0,168,234,0.12), rgba(255,255,255,0.015)); border-radius: var(--r); transition: transform 220ms var(--easing), border-color 220ms var(--easing); }
    .post-feature:hover { transform: translateY(-4px); border-color: rgba(0,168,234,0.5); }
    .post-feature h3 { font: 800 clamp(24px, 2.8vw, 34px)/1.12 var(--font-display); letter-spacing: -0.025em; margin: 0; color: var(--w-fg); }
    .post-feature p { font: 400 16px/1.6 var(--font-ui); color: var(--w-fg-2); margin: 0; }
    .post-feature .link-arrow { margin-top: 6px; }
    .post-list { display: grid; align-content: start; }
    .post-row { display: grid; gap: 8px; padding: 22px 0; border-top: 1px solid var(--w-line); }
    .post-row:first-child { border-top: 0; }
    .post-row h3 { font: 600 18px/1.3 var(--font-ui); color: var(--w-fg); margin: 0; transition: color 180ms var(--easing); }
    .post-row:hover h3 { color: var(--w-accent-2); }
    .post-meta { display: flex; gap: 16px; font: 500 13px var(--font-ui); color: var(--w-fg-3); }
    .post-meta .cat { color: var(--w-accent-2); }
    .link-arrow.all { margin-top: 22px; }
    @media (max-width: 820px) { .posts { grid-template-columns: 1fr; } .post-feature { min-height: 0; } }

    /* CTA */
    .cta { padding-block: clamp(90px, 13vw, 180px); background: radial-gradient(120% 140% at 80% 0%, rgba(0,168,234,0.18), transparent 55%), var(--w-deep); border-top: 1px solid var(--w-line); }
    .cta-inner { max-width: 760px; }
    .cta .display { font-size: clamp(40px, 7vw, 92px); }
    .cta p { font: 400 clamp(17px, 2vw, 20px)/1.6 var(--font-ui); color: var(--w-fg-2); margin: 24px 0 36px; max-width: 48ch; }

    /* Footer */
    .foot { background: var(--w-darkest); border-top: 1px solid var(--w-line); padding: clamp(56px, 7vw, 84px) 0 40px; }
    .foot-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 44px; }
    .foot-brand img { height: 28px; width: auto; margin-bottom: 18px; }
    .foot-brand p { font: 400 14px/1.6 var(--font-ui); color: var(--w-fg-2); margin: 0; max-width: 320px; }
    .foot-col h4 { font: 600 14px var(--font-ui); color: var(--w-fg); margin: 0 0 16px; }
    .foot-col a { display: block; font: 400 14px var(--font-ui); color: var(--w-fg-2); margin-bottom: 11px; transition: color 160ms var(--easing); }
    .foot-col a:hover { color: var(--w-accent-2); }
    .foot-base { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-top: clamp(40px, 5vw, 64px); padding-top: 24px; border-top: 1px solid var(--w-line); font: 400 13px var(--font-ui); color: var(--w-fg-3); }
    @media (max-width: 820px) { .foot-grid { grid-template-columns: 1fr 1fr; } .foot-brand { grid-column: 1 / -1; } }

    /* ---------- Scroll reveal ---------- */
    .reveal { opacity: 0; transform: translateY(20px); transition: opacity 0.6s var(--easing), transform 0.6s var(--easing); }
    .reveal.in { opacity: 1; transform: none; }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      .line { transform: none; animation: none; }
      .hero-sub, .hero-actions { opacity: 1; animation: none; }
      .marquee-track { animation: none; flex-wrap: wrap; width: auto; }
      .reveal { opacity: 1; transform: none; transition: none; }
      .btn, .btn svg, .seg-tile, .bento-cell, .post-feature, .link-arrow svg { transition: none; }
    }
  </style>

  <script>
    // Nav móvil
    const toggle = document.getElementById('navToggle');
    const mobile = document.getElementById('navMobile');
    toggle?.addEventListener('click', () => {
      const open = mobile?.toggleAttribute('data-open');
      if (mobile) mobile.hidden = !open;
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    });

    // Estado "scrolled" del nav sin listener de scroll
    const nav = document.getElementById('nav');
    const top = document.getElementById('top');
    if (nav && top) {
      new IntersectionObserver(([e]) => {
        nav.toggleAttribute('data-scrolled', !e.isIntersecting);
      }, { rootMargin: '0px' }).observe(top);
    }

    // Reveal en scroll
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      }
    }, { threshold: 0.14 });
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
  </script>
</body>
</html>
