---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomePage from '../components/pages/HomePage.astro';
import { getPostCards } from '../lib/posts';
const posts = await getPostCards('es');
---
<BaseLayout
  lang="es"
  current="home"
  title="Interastar · ERP, CX e IA en la nube · Partner Gold Acumatica"
  description="Firma de servicios tecnológicos B2B e integrador de sistemas. Unificamos ERP en la nube, CX e IA conversacional con Acumatica, Genesys, Numia, Infobip y Vonage."
>
  <HomePage lang="es" posts={posts} />
</BaseLayout>
