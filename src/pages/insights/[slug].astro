---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { getPosts, slugOf, fmtDate } from '../../lib/posts';
import { path, useTranslations } from '../../i18n/ui';

export async function getStaticPaths() {
  const posts = await getPosts('es');
  return posts.map((p) => ({ params: { slug: slugOf(p.id) }, props: { entry: p } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const slug = slugOf(entry.id);
const lang = 'es';
const t = useTranslations(lang);
---
<BaseLayout
  lang={lang}
  title={`${entry.data.title} · Interastar`}
  description={entry.data.description}
  alternates={{ es: `/insights/${slug}/`, en: `/en/insights/${slug}/` }}
>
  <article class="section pt-12">
    <div class="wrap prose">
      <p class="crumbs"><a href={path('insights', lang)}>Insights</a> / {entry.data.category}</p>
      <h1 class="h1 text-[clamp(30px,4vw,48px)] mb-3">{entry.data.title}</h1>
      <p class="lede mb-4">{entry.data.description}</p>
      <p class="post-meta"><span class="cat">{entry.data.category}</span><span>{fmtDate(entry.data.pubDate, lang)}</span><span>{entry.data.author}</span></p>
      <hr />
      <Content />
      <hr />
      <a class="btn btn-primary" href={path('contact', lang)}>{t('cta.primary')}<Icon name="arrow-right" size={18} /></a>
    </div>
  </article>
  <CtaBand lang={lang} />
</BaseLayout>
