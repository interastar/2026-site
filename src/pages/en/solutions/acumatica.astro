---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AcumaticaPage from '../../../components/pages/AcumaticaPage.astro';
const breadcrumb = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.interastar.com/en/' },
  { '@type': 'ListItem', position: 2, name: 'Solutions', item: 'https://www.interastar.com/en/solutions/' },
  { '@type': 'ListItem', position: 3, name: 'Acumatica ERP', item: 'https://www.interastar.com/en/solutions/acumatica/' },
] };
---
<BaseLayout
  lang="en"
  current="acumatica"
  title="Acumatica cloud ERP · Gold Certified Partner · Interastar"
  description="We implement and customize Acumatica: cloud ERP for finance, operations and inventory. Scalable, no hidden costs, with open integrations."
  jsonLd={breadcrumb}
>
  <AcumaticaPage lang="en" />
</BaseLayout>
