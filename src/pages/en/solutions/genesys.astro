---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GenesysPage from '../../../components/pages/GenesysPage.astro';
const breadcrumb = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.interastar.com/en/' },
  { '@type': 'ListItem', position: 2, name: 'Solutions', item: 'https://www.interastar.com/en/solutions/' },
  { '@type': 'ListItem', position: 3, name: 'Genesys Cloud CX', item: 'https://www.interastar.com/en/solutions/genesys/' },
] };
---
<BaseLayout
  lang="en"
  current="genesys"
  title="Genesys Cloud CX · Silver Tier Partner · Interastar"
  description="We implement, integrate and operate Genesys Cloud: omnichannel customer experience with intelligent routing, AI and real-time analytics."
  jsonLd={breadcrumb}
>
  <GenesysPage lang="en" />
</BaseLayout>
