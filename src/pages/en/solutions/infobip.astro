---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import InfobipPage from '../../../components/pages/InfobipPage.astro';
const breadcrumb = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.interastar.com/en/' },
  { '@type': 'ListItem', position: 2, name: 'Solutions', item: 'https://www.interastar.com/en/solutions/' },
  { '@type': 'ListItem', position: 3, name: 'Infobip AgentOS', item: 'https://www.interastar.com/en/solutions/infobip/' },
] };
---
<BaseLayout
  lang="en"
  current="infobip"
  title="Infobip AgentOS · Omnichannel AI agents & messaging · Interastar"
  description="We implement and integrate Infobip: AI agents (AgentOS) on an omnichannel base (WhatsApp, SMS, email, chat and voice), connected to your ERP, CRM and CX."
  jsonLd={breadcrumb}
>
  <InfobipPage lang="en" />
</BaseLayout>
