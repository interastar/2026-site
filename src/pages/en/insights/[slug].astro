---
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CtaBand from '../../../components/CtaBand.astro';
import Icon from '../../../components/Icon.astro';
import { getPosts, slugOf, fmtDate } from '../../../lib/posts';
import { path } from '../../../i18n/ui';

export async function getStaticPaths() {
  const posts = await getPosts('en');
  return posts.map((p) => ({ params: { slug: slugOf(p.id) }, props: { entry: p } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const slug = slugOf(entry.id);
const lang = 'en';
---
<BaseLayout
  lang={lang}
  title={`${entry.data.title} · Interastar`}
  description={entry.data.description}
  alternates={{ es: `/insights/${slug}/`, en: `/en/insights/${slug}/` }}
>
  <article class="section" style="padding-top:48px">
    <div class="wrap prose">
      <p class="crumbs"><a href={path('insights', lang)}>Insights</a> / {entry.data.category}</p>
      <h1 class="h1" style="font-size:clamp(30px,4vw,48px);margin-bottom:12px">{entry.data.title}</h1>
      <p class="lede" style="margin-bottom:8px">{entry.data.description}</p>
      <p class="muted" style="font-size:14px">{entry.data.category} · {fmtDate(entry.data.pubDate, lang)} · {entry.data.author}</p>
      <hr />
      <Content />
      <hr />
      <a class="btn primary" href={path('contact', lang)}>Book a diagnostic<Icon name="arrow-right" size={18} /></a>
    </div>
  </article>
  <CtaBand lang={lang} />
</BaseLayout>
