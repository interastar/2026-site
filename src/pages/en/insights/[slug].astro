---
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CtaBand from '../../../components/CtaBand.astro';
import Icon from '../../../components/Icon.astro';
import { getPosts, slugOf, fmtDate } from '../../../lib/posts';
import ArticleBanner from '../../../components/ArticleBanner.astro';
import { path, useTranslations } from '../../../i18n/ui';

export async function getStaticPaths() {
  const posts = await getPosts('en');
  return posts.map((p) => ({ params: { slug: slugOf(p.id) }, props: { entry: p } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const slug = slugOf(entry.id);
const lang = 'en';
const t = useTranslations(lang);
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.pubDate.toISOString(),
  author: { '@type': 'Organization', name: entry.data.author || 'Interastar' },
  publisher: { '@type': 'Organization', name: 'Interastar', logo: { '@type': 'ImageObject', url: 'https://www.interastar.com/brand/logo-interastar.svg' } },
  mainEntityOfPage: `https://www.interastar.com/en/insights/${slug}/`,
  articleSection: entry.data.category,
};
---
<BaseLayout
  lang={lang}
  title={`${entry.data.title} · Interastar`}
  description={entry.data.description}
  alternates={{ es: `/insights/${slug}/`, en: `/en/insights/${slug}/` }}
  jsonLd={articleLd}
>
  <ArticleBanner lang={lang} title={entry.data.title} description={entry.data.description} category={entry.data.category} date={fmtDate(entry.data.pubDate, lang)} author={entry.data.author} slug={slug} />
  <article class="section pt-12">
    <div class="wrap prose">
      <Content />
      <hr />
      <a class="btn btn-primary" href={path('contact', lang)}>{t('cta.primary')}<Icon name="arrow-right" size={18} /></a>
    </div>
  </article>
  <CtaBand lang={lang} />
</BaseLayout>
