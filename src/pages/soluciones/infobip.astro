---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InfobipPage from '../../components/pages/InfobipPage.astro';
const breadcrumb = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://www.interastar.com/' },
  { '@type': 'ListItem', position: 2, name: 'Soluciones', item: 'https://www.interastar.com/soluciones/' },
  { '@type': 'ListItem', position: 3, name: 'Infobip AgentOS', item: 'https://www.interastar.com/soluciones/infobip/' },
] };
---
<BaseLayout
  lang="es"
  current="infobip"
  title="Infobip AgentOS · Agentes de IA y mensajería omnicanal · Interastar"
  description="Implementamos e integramos Infobip: agentes de IA (AgentOS) sobre una base omnicanal (WhatsApp, SMS, correo, chat y voz), conectados a tu ERP, CRM y CX."
  jsonLd={breadcrumb}
>
  <InfobipPage lang="es" />
</BaseLayout>
