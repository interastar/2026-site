---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GenesysPage from '../../components/pages/GenesysPage.astro';
const breadcrumb = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://www.interastar.com/' },
  { '@type': 'ListItem', position: 2, name: 'Soluciones', item: 'https://www.interastar.com/soluciones/' },
  { '@type': 'ListItem', position: 3, name: 'Genesys Cloud CX', item: 'https://www.interastar.com/soluciones/genesys/' },
] };
---
<BaseLayout
  lang="es"
  current="genesys"
  title="Genesys Cloud CX · Silver Tier Partner · Interastar"
  description="Implementamos, integramos y operamos Genesys Cloud: experiencia de cliente omnicanal con enrutamiento inteligente, IA y analítica en tiempo real."
  jsonLd={breadcrumb}
>
  <GenesysPage lang="es" />
</BaseLayout>
