---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AcumaticaPage from '../../components/pages/AcumaticaPage.astro';
const breadcrumb = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://www.interastar.com/' },
  { '@type': 'ListItem', position: 2, name: 'Soluciones', item: 'https://www.interastar.com/soluciones/' },
  { '@type': 'ListItem', position: 3, name: 'Acumatica ERP', item: 'https://www.interastar.com/soluciones/acumatica/' },
] };
---
<BaseLayout
  lang="es"
  current="acumatica"
  title="Acumatica ERP · Gold Certified Partner · Interastar"
  description="Implementamos y personalizamos Acumatica: ERP en la nube para finanzas, operaciones e inventario. Escalable, sin costos ocultos y con integraciones abiertas."
  jsonLd={breadcrumb}
>
  <AcumaticaPage lang="es" />
</BaseLayout>
