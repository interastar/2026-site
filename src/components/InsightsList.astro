---
import type { Lang } from '../i18n/ui';

interface Card { title: string; description: string; category: string; date: string; href: string }
interface Props { lang: Lang; posts: Card[] }
const { lang, posts } = Astro.props;

const c = lang === 'es'
  ? { eyebrow: 'Insights', h1: 'Conocimiento para decidir mejor', lede: 'Tendencias, guías y casos sobre ERP, CX e IA aplicada al negocio.', empty: 'Pronto publicaremos nuevos artículos.' }
  : { eyebrow: 'Insights', h1: 'Knowledge to decide better', lede: 'Trends, guides and cases on ERP, CX and AI applied to business.', empty: 'New articles coming soon.' };

const [featured, ...rest] = posts;
---
<section class="section">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow"><span class="star-dot"></span>{c.eyebrow}</span>
      <h1 class="h1">{c.h1}</h1>
      <p class="lede">{c.lede}</p>
    </div>

    {!featured ? (
      <p class="muted">{c.empty}</p>
    ) : (
      <div class="posts">
        <a class="post-feature reveal" href={featured.href}>
          <span class="post-meta"><span class="cat">{featured.category}</span><span>{featured.date}</span></span>
          <h3>{featured.title}</h3>
          <p>{featured.description}</p>
        </a>
        <div class="post-list">
          {rest.map((p) => (
            <a class="post-row reveal" href={p.href}>
              <span class="post-meta"><span class="cat">{p.category}</span><span>{p.date}</span></span>
              <h3>{p.title}</h3>
              <p>{p.description}</p>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</section>
