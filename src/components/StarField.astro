---
/**
 * StarField — Hero de "puntos digitales" que forman la silueta de la estrella
 * de Interastar y rotan en pseudo-3D (canvas 2D, sin dependencias).
 *
 * - Muestrea el propio star.svg (mismo origen -> sin taint) y toma los colores
 *   reales de cada aspa (navy -> deep -> blue -> cyan -> green), aclarados para
 *   leerse sobre fondo oscuro.
 * - Rotación continua en Y (y leve X), proyección en perspectiva, profundidad
 *   por tamaño/opacidad. Parallax sutil con el mouse (sin listeners de scroll).
 * - Entrada: los puntos se ensamblan desde posiciones dispersas.
 * - ~30fps, DPR capado a 2, pausa fuera de viewport / pestaña oculta.
 * - prefers-reduced-motion o ?still=1: estrella formada y estática, sin rotar.
 */
---
<canvas id="starField" class="starfield" aria-hidden="true"></canvas>

<style>
  .starfield { position: absolute; inset: 0; width: 100%; height: 100%; display: block; z-index: 0; }
</style>

<script>
  const canvas = document.getElementById('starField') as HTMLCanvasElement | null;
  if (canvas) {
    const ctx = canvas.getContext('2d')!;
    const wrap = canvas.parentElement as HTMLElement;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
      || new URLSearchParams(location.search).has('still');

    type P = { bx: number; by: number; bz: number; sx: number; sy: number; sz: number; c: string };
    let pts: P[] = [];
    let W = 0, H = 0, DPR = 1, cx = 0, cy = 0, scale = 1;
    let raf = 0, running = false, t = 0, last = 0, intro = 0;
    let mtx = 0, mty = 0, rx = 0, ry = 0; // objetivo y actual de rotación por mouse
    const FRAME_MS = 1000 / 30;
    let built = false;

    function brighten(r: number, g: number, b: number): string {
      // Eleva la luminancia conservando el matiz del aspa (navy se vuelve azul vivo).
      const mx = Math.max(r, g, b, 1);
      const k = Math.min(255 / mx, 2.4) * 0.92;
      const R = Math.min(255, Math.round(r * k + 18));
      const G = Math.min(255, Math.round(g * k + 22));
      const B = Math.min(255, Math.round(b * k + 26));
      return `${R},${G},${B}`;
    }

    function sampleStar(): Promise<P[]> {
      return new Promise((resolve) => {
        const img = new Image();
        img.onload = () => {
          const RH = 300;
          const ar = (img.width || 153) / (img.height || 151);
          const rw = Math.max(1, Math.round(RH * ar)), rh = RH;
          const oc = document.createElement('canvas'); oc.width = rw; oc.height = rh;
          const octx = oc.getContext('2d')!;
          octx.drawImage(img, 0, 0, rw, rh);
          let data: Uint8ClampedArray;
          try { data = octx.getImageData(0, 0, rw, rh).data; }
          catch { resolve([]); return; }
          const out: P[] = [];
          const step = 3;
          for (let y = 0; y < rh; y += step) {
            for (let x = 0; x < rw; x += step) {
              const i = (y * rw + x) * 4;
              if (data[i + 3] > 90) {
                const jx = (Math.random() - 0.5) * step;
                const jy = (Math.random() - 0.5) * step;
                out.push({
                  bx: (x - rw / 2) + jx,
                  by: (y - rh / 2) + jy,
                  bz: (Math.random() * 2 - 1) * rh * 0.14,
                  sx: 0, sy: 0, sz: 0,
                  c: brighten(data[i], data[i + 1], data[i + 2]),
                });
              }
            }
          }
          // posiciones de dispersión inicial (para el ensamblaje)
          for (const p of out) {
            const a = Math.random() * Math.PI * 2, r = (0.9 + Math.random() * 1.4);
            p.sx = p.bx + Math.cos(a) * rh * r;
            p.sy = p.by + Math.sin(a) * rh * r;
            p.sz = (Math.random() * 2 - 1) * rh * 0.9;
          }
          resolve(out);
        };
        img.onerror = () => resolve([]);
        img.src = '/brand/star.svg';
      });
    }

    function resize() {
      const rect = wrap.getBoundingClientRect();
      DPR = Math.min(window.devicePixelRatio || 1, 2);
      W = rect.width; H = rect.height;
      canvas.width = Math.round(W * DPR); canvas.height = Math.round(H * DPR);
      ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
      // La estrella se ancla hacia la derecha del hero.
      cx = W > 900 ? W * 0.72 : W * 0.5;
      cy = H * (W > 900 ? 0.5 : 0.66);
      const fit = Math.min(W, H);
      scale = (W > 900 ? fit * 0.62 : fit * 0.6) / 300;
    }

    function draw() {
      ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
      // fondo degradado (familia ink)
      const bg = ctx.createLinearGradient(0, 0, W * 0.5, H);
      bg.addColorStop(0, '#02101a'); bg.addColorStop(0.6, '#042233'); bg.addColorStop(1, '#021a29');
      ctx.fillStyle = bg; ctx.fillRect(0, 0, W, H);

      // glow detrás de la estrella
      const gl = ctx.createRadialGradient(cx, cy, 0, cx, cy, 300 * scale);
      gl.addColorStop(0, 'rgba(0,168,234,0.20)'); gl.addColorStop(0.5, 'rgba(0,168,234,0.06)'); gl.addColorStop(1, 'rgba(0,168,234,0)');
      ctx.fillStyle = gl; ctx.fillRect(0, 0, W, H);

      const ease = intro < 1 ? 1 - Math.pow(1 - intro, 3) : 1;
      const spin = reduce ? -0.5 : t * 0.0022; // ángulo base de rotación Y
      const ay = spin + ry; const ax = (reduce ? 0.18 : Math.sin(t * 0.0012) * 0.12) + rx;
      const cosY = Math.cos(ay), sinY = Math.sin(ay), cosX = Math.cos(ax), sinX = Math.sin(ax);
      const persp = 560;

      ctx.globalCompositeOperation = 'lighter';
      for (let k = 0; k < pts.length; k++) {
        const p = pts[k];
        // interpolación de ensamblaje
        const x0 = p.sx + (p.bx - p.sx) * ease;
        const y0 = p.sy + (p.by - p.sy) * ease;
        const z0 = p.sz + (p.bz - p.sz) * ease;
        // rotación Y luego X
        let rxp = x0 * cosY + z0 * sinY;
        let rzp = -x0 * sinY + z0 * cosY;
        let ryp = y0 * cosX - rzp * sinX;
        rzp = y0 * sinX + rzp * cosX;
        const dz = persp / (persp + rzp * scale);
        const px = cx + rxp * scale * dz;
        const py = cy + ryp * scale * dz;
        const depth = Math.max(0, Math.min(1, (rzp + 220) / 440));
        const size = (0.6 + depth * 1.9) * Math.max(0.7, scale);
        const alpha = (0.18 + depth * 0.72) * (0.35 + 0.65 * ease);
        ctx.fillStyle = `rgba(${p.c},${alpha.toFixed(3)})`;
        ctx.beginPath();
        ctx.arc(px, py, size, 0, 6.283);
        ctx.fill();
      }
      ctx.globalCompositeOperation = 'source-over';
    }

    function frame() {
      t += 1;
      if (intro < 1 && !reduce) intro = Math.min(1, intro + 0.018);
      else if (reduce) intro = 1;
      ry += (mtx - ry) * 0.05; rx += (mty - rx) * 0.05;
      draw();
      if (!reduce && running) raf = requestAnimationFrame(tick);
    }
    function tick(now: number) {
      if (now - last < FRAME_MS) { raf = requestAnimationFrame(tick); return; }
      last = now; frame();
    }
    function start() { if (!running && built) { running = true; raf = requestAnimationFrame(tick); } }
    function stop() { running = false; cancelAnimationFrame(raf); }

    (async () => {
      pts = await sampleStar();
      built = true;
      resize();
      if (reduce) { intro = 1; draw(); return; }
      intro = 0; draw();
      const io = new IntersectionObserver((es) => { for (const e of es) e.isIntersecting ? start() : stop(); }, { threshold: 0.02 });
      io.observe(wrap);
      document.addEventListener('visibilitychange', () => { document.hidden ? stop() : start(); });
      let rt: number;
      new ResizeObserver(() => { clearTimeout(rt); rt = window.setTimeout(() => { resize(); draw(); }, 150); }).observe(wrap);
      window.addEventListener('pointermove', (e) => {
        const r = wrap.getBoundingClientRect();
        mtx = ((e.clientX - r.left) / r.width - 0.5) * 0.5;
        mty = ((e.clientY - r.top) / r.height - 0.5) * -0.3;
      }, { passive: true });
      start();
    })();
  }
</script>
