---
/**
 * Phosphor Icons (regular weight) rendered inline from the Iconify JSON set.
 * Source: @iconify-json/ph (MIT). One icon family for the whole site.
 * Legacy names used across pages are mapped to their Phosphor equivalents.
 */
import icons from '@iconify-json/ph/icons.json';

interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 22, class: className } = Astro.props;

const alias: Record<string, string> = {
  menu: 'list',
  'message-square': 'chat-circle-dots',
  workflow: 'flow-arrow',
  'line-chart': 'chart-line-up',
  sparkles: 'sparkle',
  mail: 'envelope-simple',
  linkedin: 'linkedin-logo',
  layers: 'stack',
  'refresh-cw': 'arrows-clockwise',
  'building-2': 'buildings',
  users: 'users-three',
  'plug-zap': 'plugs-connected',
  rocket: 'rocket-launch',
};

const key = alias[name] ?? name;
const body = (icons.icons as Record<string, { body: string }>)[key]?.body ?? '';
if (!body) console.warn(`[Icon] unknown icon "${name}"`);
---
<svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 256 256" fill="currentColor" class={className} aria-hidden="true" set:html={body}></svg>
