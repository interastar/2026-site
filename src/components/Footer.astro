---
import Icon from './Icon.astro';
import { path, useTranslations, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---
<footer class="bg-(--bg-surface) border-t border-(--border) py-16">
  <div class="wrap">
    <div class="grid grid-cols-1 md:grid-cols-5 gap-12 mb-12">
      <div class="md:col-span-2">
        <img src="/brand/logo-interastar-dark.svg" alt="Interastar" width="120" height="32" class="h-8 w-auto mb-4" />
        <p class="text-sm leading-relaxed text-(--fg-2) max-w-[320px]">{t('footer.tagline')}</p>
      </div>

      <div>
        <h4 class="text-sm font-semibold text-(--fg-1) mb-4">{t('footer.solutions')}</h4>
        <ul class="list-none p-0 m-0 grid gap-2">
          <li><a class="text-sm text-(--fg-2) hover:text-(--accent)" href={path('acumatica', lang)}>Acumatica ERP</a></li>
          <li><a class="text-sm text-(--fg-2) hover:text-(--accent)" href={path('genesys', lang)}>Genesys CX</a></li>
          <li><a class="text-sm text-(--fg-2) hover:text-(--accent)" href={path('infobip', lang)}>Infobip AgentOS</a></li>
          <li><a class="text-sm text-(--fg-2) hover:text-(--accent)" href={path('solutions', lang)}>{t('footer.integration')}</a></li>
          <li><a class="text-sm text-(--fg-2) hover:text-(--accent)" href={path('solutions', lang)}>{t('footer.managed')}</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-sm font-semibold text-(--fg-1) mb-4">{t('footer.company')}</h4>
        <ul class="list-none p-0 m-0 grid gap-2">
          <li><a class="text-sm text-(--fg-2) hover:text-(--accent)" href={path('about', lang)}>{t('footer.about')}</a></li>
          <li><a class="text-sm text-(--fg-2) hover:text-(--accent)" href={path('insights', lang)}>{t('footer.insights')}</a></li>
          <li><a class="text-sm text-(--fg-2) hover:text-(--accent)" href={path('contact', lang)}>{t('footer.contact')}</a></li>
          <li><a class="text-sm text-(--fg-2) hover:text-(--accent)" href={path('privacy', lang)}>{t('footer.privacy')}</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-sm font-semibold text-(--fg-1) mb-4">{t('footer.contact')}</h4>
        <ul class="list-none p-0 m-0 grid gap-2">
          <li><a class="text-sm text-(--fg-2) hover:text-(--accent)" href="mailto:contacto@interastar.com">contacto@interastar.com</a></li>
          <li><a class="text-sm text-(--fg-2) hover:text-(--accent)" href="https://www.linkedin.com/company/interastar" rel="noopener" target="_blank">LinkedIn</a></li>
        </ul>
      </div>
    </div>

    <div class="w-full border-t border-(--border) pt-6 flex items-center justify-between gap-4 flex-wrap">
      <div class="text-sm text-(--fg-3) grid gap-1">
        <span>© {year} Interastar. {t('footer.rights')}</span>
        <span>Acumatica Gold Certified Partner · Genesys Silver Tier Partner</span>
      </div>
      <div class="flex gap-4 items-center">
        <a href="https://www.linkedin.com/company/interastar" rel="noopener" target="_blank" aria-label="LinkedIn" class="text-(--fg-3) hover:text-(--accent)"><Icon name="linkedin" size={18} /></a>
        <a href={path('privacy', lang)} class="text-sm text-(--fg-3) hover:text-(--accent)">{t('footer.privacy')}</a>
      </div>
    </div>
  </div>
</footer>
