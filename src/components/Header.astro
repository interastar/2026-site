---
import Icon from './Icon.astro';
import { path, useTranslations, type Lang, type RouteKey } from '../i18n/ui';

interface Props {
  lang: Lang;
  current?: RouteKey;
  altPath: string; // equivalent page URL in the other language
}
const { lang, current, altPath } = Astro.props;
const t = useTranslations(lang);
const other: Lang = lang === 'es' ? 'en' : 'es';

const links: { key: RouteKey; label: string }[] = [
  { key: 'solutions', label: t('nav.solutions') },
  { key: 'about', label: t('nav.about') },
  { key: 'insights', label: t('nav.insights') },
  { key: 'contact', label: t('nav.contact') },
];
---
<header class="nav">
  <div class="wrap nav-inner">
    <a class="brand" href={path('home', lang)} aria-label="Interastar">
      <img src="/brand/logo-interastar.svg" alt="Interastar" class="h-8 w-auto" />
    </a>

    <div class="ml-auto flex items-center gap-4">
      <nav aria-label={lang === 'es' ? 'Principal' : 'Main'}>
        <ul id="navLinks" class="nav-links hidden md:flex items-center gap-7">
          {links.map((l) => (
            <li class={l.key === 'solutions' ? 'relative md:group' : ''}>
              <a class="text-sm text-(--fg-2) hover:text-(--fg-1)" href={path(l.key, lang)} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a>
              {l.key === 'solutions' && (
                <ul class="flex flex-col gap-2 md:hidden md:group-hover:flex md:absolute md:top-full md:left-0 md:min-w-50 md:bg-base-100 md:border md:rounded-md md:shadow-lg md:py-2 md:px-0">
                  <li><a class="px-3 py-1 text-sm text-(--fg-2) hover:bg-(--ia-mist)" href={path('acumatica', lang)}>{t('nav.acumatica')}</a></li>
                  <li><a class="px-3 py-1 text-sm text-(--fg-2) hover:bg-(--ia-mist)" href={path('genesys', lang)}>{t('nav.genesys')}</a></li>
                </ul>
              )}
            </li>
          ))}
          <li class="block md:hidden mt-2"><a href={path('contact', lang)} class="btn btn-primary w-full justify-center">{t('nav.cta')}</a></li>
        </ul>
      </nav>

      <div class="nav-actions nav-actions--bordered">
        <a class="lang-switch" href={altPath} hreflang={other} aria-label={`Switch to ${other === 'es' ? 'Español' : 'English'}`}>
          <Icon name="globe" size={14} />
          {t('lang.switch')}
        </a>
        <a class="btn btn-primary hidden md:inline-flex" href={path('contact', lang)}>{t('nav.cta')}</a>
        <button id="navToggle" class="nav-toggle md:hidden inline-flex" aria-label="Menu" aria-expanded="false" aria-controls="navLinks">
          <Icon name="menu" size={24} />
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('navToggle');
  const links = document.getElementById('navLinks');
  toggle?.addEventListener('click', () => {
    const nowHidden = links.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', nowHidden ? 'false' : 'true');
  });

  const nav = document.querySelector('.nav') as HTMLElement;
  const onScroll = () => {
    nav?.toggleAttribute('data-scrolled', window.scrollY > 40);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
