---
import Icon from './Icon.astro';
import { path, useTranslations, type Lang, type RouteKey } from '../i18n/ui';

interface Props {
  lang: Lang;
  current?: RouteKey;
  altPath: string; // equivalent page URL in the other language
}
const { lang, current, altPath } = Astro.props;
const t = useTranslations(lang);
const other: Lang = lang === 'es' ? 'en' : 'es';

const links: { key: RouteKey; label: string }[] = [
  { key: 'solutions', label: t('nav.solutions') },
  { key: 'about', label: t('nav.about') },
  { key: 'insights', label: t('nav.insights') },
  { key: 'contact', label: t('nav.contact') },
];
---
<header class="nav">
  <div class="wrap nav-inner">
    <a class="brand" href={path('home', lang)} aria-label="Interastar">
      <img src="/brand/logo-interastar-dark.svg" alt="Interastar" width="120" height="32" />
    </a>

    <div class="ml-auto flex items-center gap-4">
      <nav aria-label={lang === 'es' ? 'Principal' : 'Main'}>
        <ul id="navLinks" class="nav-links hidden md:flex items-center gap-7">
          {links.map((l) => (
            <li class={l.key === 'solutions' ? 'has-menu' : ''}>
              <a href={path(l.key, lang)} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a>
              {l.key === 'solutions' && (
                <ul class="nav-menu">
                  <li><a href={path('acumatica', lang)}>{t('nav.acumatica')}</a></li>
                  <li><a href={path('genesys', lang)}>{t('nav.genesys')}</a></li>
                  <li><a href={path('infobip', lang)}>{t('nav.infobip')}</a></li>
                </ul>
              )}
            </li>
          ))}
          <li class="block md:hidden mt-2"><a href={path('contact', lang)} class="btn btn-primary w-full">{t('nav.cta')}</a></li>
        </ul>
      </nav>

      <div class="nav-actions">
        <a class="lang-switch" href={altPath} hreflang={other} aria-label={`Switch to ${other === 'es' ? 'Español' : 'English'}`}>
          <Icon name="globe" size={14} />
          {t('lang.switch')}
        </a>
        <a class="btn btn-primary hidden md:inline-flex" href={path('contact', lang)}>{t('nav.cta')}</a>
        <button id="navToggle" class="nav-toggle md:hidden" aria-label="Menu" aria-expanded="false" aria-controls="navLinks">
          <Icon name="menu" size={24} />
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('navToggle');
  const links = document.getElementById('navLinks');
  toggle?.addEventListener('click', () => {
    const nowHidden = links?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', nowHidden ? 'false' : 'true');
  });

  // Compact nav after the page scrolls past a 1px sentinel at the top. No scroll listener.
  const nav = document.querySelector('.nav');
  const sentinel = document.getElementById('navSentinel');
  if (nav && sentinel) {
    new IntersectionObserver(([e]) => {
      nav.toggleAttribute('data-scrolled', !e.isIntersecting);
    }, { rootMargin: '40px 0px 0px 0px' }).observe(sentinel);
  }
</script>
