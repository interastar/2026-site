---
/**
 * Bento de alianzas/plataformas. Dos filas:
 *  - Acumatica (ERP) + Genesys (CX), con capturas reales.
 *  - Infobip (bloque propio, prioritario), Numia y Vonage + Telnyx.
 */
import Icon from './Icon.astro';
import { path, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Destino de las celdas sin página propia (índice de soluciones o contacto). */
  otherHref: string;
}
const { lang, otherHref } = Astro.props;
const more = lang === 'es' ? 'Conocer más' : 'Learn more';

const c = {
  es: {
    acu: { tag: 'ERP en la nube', name: 'Acumatica', text: 'ERP en la nube para gestionar todo tu negocio: finanzas, operaciones e inventario con una vista completa y en tiempo real, desde cualquier lugar. Con IA integrada.', href: path('acumatica', lang) },
    gen: { tag: 'Experiencia de cliente en la nube', name: 'Genesys', text: 'Plataforma de experiencia de cliente potenciada por IA: orquesta cada interacción en tiempo real para fidelizar a tus clientes y hacer más eficientes a tus equipos.', href: path('genesys', lang) },
    infobip: { tag: 'Agentes de IA y mensajería', name: 'Infobip', text: 'Potenciado por AgentOS: crea y orquesta agentes de IA que atienden a tus clientes en todos los canales (WhatsApp, SMS, correo, chat y voz), integrados a tus sistemas.', href: otherHref },
    numia: { tag: 'IA para el mundo físico', name: 'Numia', text: 'Orquesta en tiempo real lo que pasa en tus puntos físicos: menos esperas, más conversión y datos accionables. La agilidad del mundo digital, llevada a la operación física.', href: otherHref },
    vonage: { tag: 'Voz y comunicaciones', name: 'Vonage y Telnyx', text: 'APIs e infraestructura de comunicación (voz, mensajería, video y verificación) para integrar la comunicación en tus aplicaciones, incluida voz para agentes de IA en tiempo real.', href: otherHref },
  },
  en: {
    acu: { tag: 'Cloud ERP', name: 'Acumatica', text: 'Cloud ERP to run your whole business: finance, operations and inventory with a complete, real-time view from anywhere. With built-in AI.', href: path('acumatica', lang) },
    gen: { tag: 'Cloud CX', name: 'Genesys', text: 'An AI-powered customer experience platform: it orchestrates every interaction in real time to build loyalty and more efficient teams.', href: path('genesys', lang) },
    infobip: { tag: 'AI agents & messaging', name: 'Infobip', text: 'Powered by AgentOS: build and orchestrate AI agents that serve customers across every channel (WhatsApp, SMS, email, chat and voice), integrated into your systems.', href: otherHref },
    numia: { tag: 'AI for the physical world', name: 'Numia', text: 'Orchestrates in real time what happens at your physical locations: shorter waits, more conversion and actionable data. Digital agility, brought to physical operations.', href: otherHref },
    vonage: { tag: 'Voice & communications', name: 'Vonage and Telnyx', text: 'Communication APIs and infrastructure (voice, messaging, video and verification) to embed communications in your apps, including voice for real-time AI agents.', href: otherHref },
  },
}[lang];
---
<div class="bento">
  <a class="bento-cell span-7 tint-cyan has-shot reveal" href={c.acu.href}>
    <div class="logos"><img src="/partners/acumatica-white.png" alt="Acumatica" width="1045" height="255" loading="lazy" decoding="async" /></div>
    <span class="tag">{c.acu.tag}</span>
    <h3>{c.acu.name}</h3>
    <p>{c.acu.text}</p>
    <span class="link-arrow">{more}<Icon name="arrow-right" /></span>
    <img class="shot" src="/screens/acumatica-dashboard.png" alt="" width="1838" height="960" loading="lazy" decoding="async" />
  </a>

  <a class="bento-cell span-5 tint-green has-shot reveal" href={c.gen.href}>
    <div class="logos"><img src="/partners/genesys-white.png" alt="Genesys" width="1965" height="363" loading="lazy" decoding="async" /></div>
    <span class="tag">{c.gen.tag}</span>
    <h3>{c.gen.name}</h3>
    <p>{c.gen.text}</p>
    <span class="link-arrow">{more}<Icon name="arrow-right" /></span>
    <img class="shot" src="/screens/genesys-dashboard.png" alt="" width="1920" height="1079" loading="lazy" decoding="async" />
  </a>

  <a class="bento-cell span-5 reveal" href={c.infobip.href}>
    <div class="logos"><img src="/partners/infobip-white.svg" alt="Infobip" loading="lazy" decoding="async" /></div>
    <span class="tag">{c.infobip.tag}</span>
    <h3>{c.infobip.name}</h3>
    <p>{c.infobip.text}</p>
    <span class="link-arrow">{more}<Icon name="arrow-right" /></span>
  </a>

  <a class="bento-cell span-4 reveal" href={c.numia.href}>
    <div class="logos"><img src="/partners/numia-white.png" alt="Numia" loading="lazy" decoding="async" /></div>
    <span class="tag">{c.numia.tag}</span>
    <h3>{c.numia.name}</h3>
    <p>{c.numia.text}</p>
    <span class="link-arrow">{more}<Icon name="arrow-right" /></span>
  </a>

  <a class="bento-cell span-3 reveal" href={c.vonage.href}>
    <div class="logos"><img src="/partners/vonage.png" alt="Vonage" loading="lazy" decoding="async" /><img src="/partners/telnyx-white.svg" alt="Telnyx" loading="lazy" decoding="async" /></div>
    <span class="tag">{c.vonage.tag}</span>
    <h3>{c.vonage.name}</h3>
    <p>{c.vonage.text}</p>
    <span class="link-arrow">{more}<Icon name="arrow-right" /></span>
  </a>
</div>
