---
import Icon from '../Icon.astro';
import LeadForm from '../LeadForm.astro';
import { path, type Lang } from '../../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;

const c = {
  es: {
    eyebrow: 'Contacto',
    h1: 'Agenda tu consultoría de diagnóstico',
    lede: 'Cuéntanos sobre tu operación y un especialista te contactará para definir el mejor camino. Sin compromiso.',
    benefits: [
      'Diagnóstico inicial sin costo',
      'Propuesta alineada a tu industria y objetivos',
      'Acompañamiento end-to-end, de la estrategia a la operación',
    ],
    channelsTitle: 'Otras formas de contacto',
    channels: [
      { ic: 'mail', label: 'Correo', value: 'contacto@interastar.com', href: 'mailto:contacto@interastar.com' },
      { ic: 'linkedin', label: 'LinkedIn', value: 'Interastar', href: 'https://www.linkedin.com/company/interastar' },
      { ic: 'map-pin', label: 'Ubicación', value: 'México · LATAM', href: null },
    ],
  },
  en: {
    eyebrow: 'Contact',
    h1: 'Book your diagnostic consultation',
    lede: 'Tell us about your operation and a specialist will reach out to define the best path. No commitment.',
    benefits: [
      'Free initial diagnosis',
      'A proposal aligned to your industry and goals',
      'End-to-end support, from strategy to operation',
    ],
    channelsTitle: 'Other ways to reach us',
    channels: [
      { ic: 'mail', label: 'Email', value: 'contacto@interastar.com', href: 'mailto:contacto@interastar.com' },
      { ic: 'linkedin', label: 'LinkedIn', value: 'Interastar', href: 'https://www.linkedin.com/company/interastar' },
      { ic: 'map-pin', label: 'Location', value: 'Mexico · LATAM', href: null },
    ],
  },
}[lang];
---
<section class="section">
  <div class="wrap form-grid">
    <div>
      <span class="eyebrow"><span class="star-dot"></span>{c.eyebrow}</span>
      <h1 class="h1" style="margin-top:14px">{c.h1}</h1>
      <p class="lede">{c.lede}</p>
      <ul class="checklist" style="margin-top:24px">
        {c.benefits.map((b) => <li><Icon name="check" size={18} />{b}</li>)}
      </ul>

      <h3 class="h3" style="font-size:16px;margin-top:40px;margin-bottom:16px">{c.channelsTitle}</h3>
      <div style="display:grid;gap:14px">
        {c.channels.map((ch) => (
          <div style="display:flex;align-items:center;gap:12px">
            <div class="ic" style="width:38px;height:38px"><Icon name={ch.ic} size={18} /></div>
            <div>
              <div style="font:700 11px var(--font-ui);letter-spacing:var(--tracking-wide);text-transform:uppercase;color:var(--fg-3)">{ch.label}</div>
              {ch.href
                ? <a href={ch.href} style="font:600 15px var(--font-ui)">{ch.value}</a>
                : <span style="font:600 15px var(--font-ui);color:var(--fg-1)">{ch.value}</span>}
            </div>
          </div>
        ))}
      </div>
    </div>

    <LeadForm lang={lang} source="contacto" />
  </div>
</section>
