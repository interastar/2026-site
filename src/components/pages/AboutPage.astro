---
import Icon from '../Icon.astro';
import Stats from '../Stats.astro';
import CtaBand from '../CtaBand.astro';
import type { Lang } from '../../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;

const c = {
  es: {
    eyebrow: 'Nosotros',
    h1: 'Conectamos la tecnología con la operación de tu negocio',
    lede: 'En Interastar implementamos, integramos y operamos las plataformas líderes de ERP, CX e IA para que tu empresa funcione como un solo sistema. Somos el aliado estratégico que garantiza la continuidad del negocio y reduce la deuda técnica.',
    missionTitle: 'Por qué existimos',
    mission: 'Las empresas no necesitan más software aislado: necesitan que sus sistemas trabajen juntos. Nuestro trabajo es convertir plataformas complejas en una ventaja operativa clara, medible y sostenible.',
    methodEyebrow: 'Cómo lo hacemos',
    methodTitle: 'Una metodología end-to-end que reduce el riesgo',
    methodText: 'Acompañamos cada etapa para que el cambio tecnológico no detenga tu operación.',
    steps: [
      { ic: 'target', title: 'Diagnóstico', text: 'Entendemos tu operación, tus objetivos y tus restricciones antes de proponer cualquier solución.' },
      { ic: 'workflow', title: 'Diseño e implementación', text: 'Configuramos y personalizamos la plataforma a tu industria, con un plan claro y entregables medibles.' },
      { ic: 'plug-zap', title: 'Integración', text: 'Conectamos tus sistemas (ERP, CRM, CX, mensajería) para eliminar el reproceso entre áreas.' },
      { ic: 'refresh-cw', title: 'Operación y mejora', text: 'Soporte administrado y evolución continua para que el valor crezca con el tiempo.' },
    ],
    valuesTitle: 'Lo que nos define',
    values: [
      { title: 'Confianza', text: 'Seguridad, transparencia y cumplimiento en cada implementación.' },
      { title: 'Cercanía', text: 'Acompañamiento real: somos equipo, no solo proveedor.' },
      { title: 'Resultados', text: 'Medimos el impacto en tiempos, costos y experiencia de cliente.' },
    ],
    partnersTitle: 'Partners de las plataformas líderes',
    partnersText: 'Somos Acumatica Gold Certified Partner y Genesys Silver Tier Partner, e integramos Numia, Infobip y Vonage.',
  },
  en: {
    eyebrow: 'About',
    h1: 'We connect technology with your business operation',
    lede: 'At Interastar we implement, integrate and operate the leading ERP, CX and AI platforms so your company runs as a single system. We are the strategic partner that ensures business continuity and reduces technical debt.',
    missionTitle: 'Why we exist',
    mission: 'Companies don\'t need more isolated software: they need their systems to work together. Our job is to turn complex platforms into a clear, measurable and sustainable operational advantage.',
    methodEyebrow: 'How we do it',
    methodTitle: 'An end-to-end methodology that reduces risk',
    methodText: 'We support every stage so technology change never stops your operation.',
    steps: [
      { ic: 'target', title: 'Diagnosis', text: 'We understand your operation, goals and constraints before proposing any solution.' },
      { ic: 'workflow', title: 'Design & implementation', text: 'We configure and tailor the platform to your industry, with a clear plan and measurable deliverables.' },
      { ic: 'plug-zap', title: 'Integration', text: 'We connect your systems (ERP, CRM, CX, messaging) to remove rework across teams.' },
      { ic: 'refresh-cw', title: 'Operation & improvement', text: 'Managed support and continuous evolution so value grows over time.' },
    ],
    valuesTitle: 'What defines us',
    values: [
      { title: 'Trust', text: 'Security, transparency and compliance in every implementation.' },
      { title: 'Closeness', text: 'Real partnership: we are a team, not just a vendor.' },
      { title: 'Results', text: 'We measure impact on time, cost and customer experience.' },
    ],
    partnersTitle: 'Partners of the leading platforms',
    partnersText: 'We are an Acumatica Gold Certified Partner and a Genesys Silver Tier Partner, and we integrate Numia, Infobip and Vonage.',
  },
}[lang];

const partners = [
  { file: 'acumatica-white.png', name: 'Acumatica' },
  { file: 'genesys-white.png', name: 'Genesys' },
  { file: 'numia-white.png', name: 'Numia' },
  { file: 'infobip-white.svg', name: 'Infobip' },
  { file: 'vonage.png', name: 'Vonage' },
];
---
<section class="section pb-10">
  <div class="wrap">
    <span class="eyebrow"><span class="star-dot"></span>{c.eyebrow}</span>
    <h1 class="h1 max-w-[880px]">{c.h1}</h1>
    <p class="lede max-w-[760px]">{c.lede}</p>
  </div>
</section>

<section class="section alt">
  <div class="wrap">
    <div class="max-w-[720px]">
      <h2 class="h2">{c.missionTitle}</h2>
      <p class="lede">{c.mission}</p>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow"><span class="star-dot"></span>{c.methodEyebrow}</span>
      <h2 class="h2 mt-3.5">{c.methodTitle}</h2>
      <p class="lede">{c.methodText}</p>
    </div>
    <ol class="timeline">
      {c.steps.map((s) => (
        <li class="tl-step reveal">
          <div class="ic"><Icon name={s.ic} /></div>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<Stats lang={lang} />

<section class="section">
  <div class="wrap">
    <h2 class="h2">{c.valuesTitle}</h2>
    <dl class="def-list mt-8">
      {c.values.map((v) => (
        <div class="def-row reveal">
          <dt>{v.title}</dt>
          <dd>{v.text}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<section class="section alt">
  <div class="wrap">
    <h3 class="h3">{c.partnersTitle}</h3>
    <p class="muted mt-2 mb-6 max-w-[60ch]">{c.partnersText}</p>
    <div class="cert-list mb-8">
      <span class="cert gold"><Icon name="seal-check" size={18} /><b>Acumatica</b><i class="tier">Gold Certified Partner</i></span>
      <span class="cert silver"><Icon name="seal-check" size={18} /><b>Genesys</b><i class="tier">Silver Tier Partner</i></span>
    </div>
    <div class="logo-row">
      {partners.map((p) => <img src={`/partners/${p.file}`} alt={p.name} loading="lazy" decoding="async" />)}
    </div>
  </div>
</section>

<CtaBand lang={lang} />
