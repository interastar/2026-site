---
import Icon from '../Icon.astro';
import Stats from '../Stats.astro';
import LeadForm from '../LeadForm.astro';
import { path, type Lang } from '../../i18n/ui';

export interface SolutionContent {
  tag: string;
  name: string;
  title: string;
  lede: string;
  logo?: { src: string; alt: string; width: number; height: number };
  image: { src: string; alt: string; width: number; height: number };
  demoCta: string;
  cert?: { label: string; cls: 'gold' | 'silver' };
  heroBullets: string[];
  capTitle: string;
  capabilities: { ic: string; title: string; text: string }[];
  whoTitle: string;
  who: { role: string; text: string }[];
  integrTitle: string;
  integrText: string;
  integrations: { file: string; name: string }[];
  formTitle: string;
}

interface Props { lang: Lang; content: SolutionContent; source: string }
const { lang, content: c, source } = Astro.props;
---
<section class="section pb-12">
  <div class="wrap">
    {c.logo && <img class="sol-logo" src={c.logo.src} alt={c.logo.alt} width={c.logo.width} height={c.logo.height} decoding="async" />}
    <p class="crumbs"><a href={path('solutions', lang)}>{lang === 'es' ? 'Soluciones' : 'Solutions'}</a> / {c.name}</p>
    <div class="split sol-hero">
      <div>
        <span class="eyebrow"><span class="star-dot"></span>{c.tag}</span>
        <h1 class="h1">{c.title}</h1>
        <p class="lede max-w-[560px]">{c.lede}</p>
        {c.cert && <div class="mt-4"><span class={`cert ${c.cert.cls}`}><Icon name="seal-check" size={18} /><i class="tier">{c.cert.label}</i></span></div>}
        <div class="hero-actions">
          <a class="btn btn-primary" href="#solicitar">{c.demoCta}<Icon name="arrow-right" size={18} /></a>
        </div>
      </div>
      <div class="shot reveal">
        <img src={c.image.src} alt={c.image.alt} width={c.image.width} height={c.image.height} fetchpriority="high" decoding="async" />
      </div>
    </div>
  </div>
</section>

<Stats lang={lang} />

<!-- Capabilities: two-column list -->
<section class="section">
  <div class="wrap">
    <div class="section-head"><h2 class="h2">{c.capTitle}</h2></div>
    <div class="list-2">
      {c.capabilities.map((cap) => (
        <div class="feat-row reveal">
          <div class="ic"><Icon name={cap.ic} /></div>
          <div>
            <h3>{cap.title}</h3>
            <p>{cap.text}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- For each role: definition rows -->
<section class="section alt">
  <div class="wrap">
    <h2 class="h2">{c.whoTitle}</h2>
    <dl class="def-list mt-8">
      {c.who.map((w) => (
        <div class="def-row reveal">
          <dt>{w.role}</dt>
          <dd>{w.text}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<!-- Integrations -->
<section class="section">
  <div class="wrap split">
    <div>
      <h2 class="h2">{c.integrTitle}</h2>
      <p class="lede">{c.integrText}</p>
    </div>
    <div class="logo-row">
      {c.integrations.map((i) => <img src={`/partners/${i.file}`} alt={i.name} loading="lazy" decoding="async" />)}
    </div>
  </div>
</section>

<!-- Demo request form -->
<section class="section alt" id="solicitar">
  <div class="wrap form-grid">
    <div>
      <span class="eyebrow"><span class="star-dot"></span>{c.tag}</span>
      <h2 class="h2 mt-3.5">{c.formTitle}</h2>
      <ul class="checklist mt-6">
        {c.heroBullets.map((b) => <li><Icon name="check" size={18} />{b}</li>)}
      </ul>
    </div>
    <LeadForm lang={lang} source={source} submit={c.demoCta} />
  </div>
</section>
