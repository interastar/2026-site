---
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { routes, useTranslations, type Lang, type RouteKey } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  current?: RouteKey;
  image?: string;
  noindex?: boolean;
  /** Explicit alternate URLs (for pages without a fixed route key, e.g. articles). */
  alternates?: { es?: string; en?: string };
}
const { title, description, lang, current, image = '/brand/og-default.svg', noindex = false, alternates } = Astro.props;
const t = useTranslations(lang);

const site = Astro.site ?? new URL('https://www.interastar.com');
const canonical = new URL(Astro.url.pathname, site).href;

// hreflang alternates: from explicit prop, else the route key map.
const altMap = alternates ?? (current ? routes[current] : null);
const esUrl = altMap?.es ? new URL(altMap.es, site).href : null;
const enUrl = altMap?.en ? new URL(altMap.en, site).href : null;
const altPath = altMap ? (altMap[lang === 'es' ? 'en' : 'es'] ?? (lang === 'es' ? '/en/' : '/')) : (lang === 'es' ? '/en/' : '/');
const ogImage = new URL(image, site).href;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/brand/star.svg" />
    <link rel="apple-touch-icon" href="/brand/star.png" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <title>{title}</title>
    <meta name="description" content={description} />

    {esUrl && <link rel="alternate" hreflang="es" href={esUrl} />}
    {enUrl && <link rel="alternate" hreflang="en" href={enUrl} />}
    {esUrl && <link rel="alternate" hreflang="x-default" href={esUrl} />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'es' ? 'es_MX' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preload" href="/fonts/PublicSans-VariableFont_wght.ttf" as="font" type="font/ttf" crossorigin />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'Interastar',
      url: site.href,
      logo: new URL('/brand/logo-interastar.svg', site).href,
      description: t('footer.tagline'),
      sameAs: ['https://www.linkedin.com/company/interastar'],
    })} />
  </head>
  <body>
    <a href="#main" class="skip-link">{t('skip')}</a>
    <Header lang={lang} current={current} altPath={altPath} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />

    <style is:global>
      .skip-link { position: absolute; left: -9999px; top: 8px; background: var(--ia-ink); color: #fff; padding: 8px 14px; border-radius: var(--r-sm); z-index: 100; }
      .skip-link:focus { left: 8px; color: #fff; }
    </style>

    <script>
      const obs = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (e.isIntersecting) { e.target.classList.add('in'); obs.unobserve(e.target); }
        }
      }, { threshold: 0.12 });
      document.querySelectorAll('.reveal').forEach((el) => obs.observe(el));
    </script>
  </body>
</html>
