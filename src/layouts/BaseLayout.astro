---
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { routes, useTranslations, type Lang, type RouteKey } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  current?: RouteKey;
  image?: string;
  noindex?: boolean;
  /** Explicit alternate URLs (for pages without a fixed route key, e.g. articles). */
  alternates?: { es?: string; en?: string };
}
const { title, description, lang, current, image = '/brand/og-default.svg', noindex = false, alternates } = Astro.props;
const t = useTranslations(lang);

const site = Astro.site ?? new URL('https://www.interastar.com');
const canonical = new URL(Astro.url.pathname, site).href;

// hreflang alternates: from explicit prop, else the route key map.
const altMap = alternates ?? (current ? routes[current] : null);
const esUrl = altMap?.es ? new URL(altMap.es, site).href : null;
const enUrl = altMap?.en ? new URL(altMap.en, site).href : null;
const altPath = altMap ? (altMap[lang === 'es' ? 'en' : 'es'] ?? (lang === 'es' ? '/en/' : '/')) : (lang === 'es' ? '/en/' : '/');
const ogImage = new URL(image, site).href;

// Google Tag Manager container carried over from the previous site.
const GTM_ID = 'GTM-NJBW67D';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/brand/star.svg" />
    <link rel="apple-touch-icon" href="/brand/star.png" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="preload" href="/fonts/exo2-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/publicsans-latin.woff2" as="font" type="font/woff2" crossorigin />

    <title>{title}</title>
    <meta name="description" content={description} />

    {esUrl && <link rel="alternate" hreflang="es" href={esUrl} />}
    {enUrl && <link rel="alternate" hreflang="en" href={enUrl} />}
    {esUrl && <link rel="alternate" hreflang="x-default" href={esUrl} />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'es' ? 'es_MX' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'Interastar',
      url: site.href,
      logo: new URL('/brand/logo-interastar.svg', site).href,
      description: t('footer.tagline'),
      sameAs: ['https://www.linkedin.com/company/interastar'],
    })} />

    <script is:inline define:vars={{ GTM_ID }}>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});
      var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';
      j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer',GTM_ID);
    </script>
  </head>
  <body>
    <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`} height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <a href="#main" class="absolute left-[-9999px] top-2 bg-(--ia-ink) text-white px-3.5 py-2 rounded-(--r-input) z-100 focus:left-2">{t('skip')}</a>
    <div id="navSentinel" aria-hidden="true" class="absolute top-0 left-0 h-px w-px"></div>
    <Header lang={lang} current={current} altPath={altPath} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      const obs = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (e.isIntersecting) { e.target.classList.add('in'); obs.unobserve(e.target); }
        }
      }, { threshold: 0.12 });
      document.querySelectorAll('.reveal').forEach((el) => obs.observe(el));
    </script>
  </body>
</html>
